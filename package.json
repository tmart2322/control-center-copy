{
  "name": "control-center",
  "version": "1.3.0",
  "private": true,
  "description": "Local personal-ops cockpit for Salesforce sellers (Solutions Engineers, Specialist AEs). Nothing leaves without approval.",
  "type": "module",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "predev": "node scripts/sync-brand-assets.mjs",
    "dev": "concurrently -k -n web,worker -c blue,magenta \"npm:dev:web\" \"npm:worker\"",
    "dev:web": "next dev -p ${PORT:-4327}",
    "worker": "tsx watch src/worker/index.ts",
    "worker:start": "tsx src/worker/index.ts",
    "prebuild": "node scripts/sync-brand-assets.mjs",
    "build": "next build",
    "start": "next start -p ${PORT:-4327}",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run typecheck && npm run lint && npm run contrast && npm run test && npm run test:db && npm run test:be1a && npm run test:be1b && npm run test:bereeval",
    "contrast": "node scripts/contrast.mjs",
    "shot": "node scripts/shot.mjs",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/db/migrate.ts",
    "db:studio": "drizzle-kit studio --port 4985",
    "seed:example": "tsx scripts/build-example-seed.ts",
    "gen:routes": "tsx scripts/gen-api-routes.ts",
    "test:db": "BE0_DATABASE_URL=postgres://localhost:5432/control_center_be0_${CC_TEST_DB_SUFFIX:-main} vitest run --config tests/be0/vitest.config.ts",
    "doctor": "tsx src/ops/doctor.ts",
    "setup": "node scripts/ops/setup.mjs",
    "ops:install": "node scripts/ops/install-agents.mjs",
    "ops:uninstall": "node scripts/ops/uninstall-agents.mjs",
    "backup": "node scripts/ops/backup.mjs",
    "restore": "node scripts/ops/restore.mjs",
    "update": "node scripts/ops/update.mjs",
    "release": "node scripts/release.mjs",
    "seed:real": "tsx scripts/seed/build-real-seed.ts",
    "test:be1a": "BE1A_DATABASE_URL=postgres://localhost:5432/control_center_be1a_${CC_TEST_DB_SUFFIX:-main} vitest run --config tests/be1a/vitest.config.ts",
    "test:be1b": "BE1B_DATABASE_URL=postgres://localhost:5432/control_center_be1b_${CC_TEST_DB_SUFFIX:-main} vitest run --config tests/be1b/vitest.config.ts",
    "test:bereeval": "vitest run --config tests/bereeval/vitest.config.ts",
    "db:seed": "tsx scripts/db/seed-from-mock.ts",
    "db:bootstrap": "tsx scripts/db/bootstrap.ts",
    "scan:trace": "tsx scripts/scan/trace.ts",
    "scan:explain": "tsx scripts/scan/explain.ts",
    "scan:report": "tsx scripts/scan/report.ts",
    "scan:private": "tsx scripts/private/scan.ts",
    "vdp:scan": "tsx scripts/vdp/scan.ts",
    "time:rederive": "tsx scripts/time-rederive.ts",
    "crawl": "node scripts/qa/crawl.mjs",
    "sample:build": "tsx sample-data/build-all.ts",
    "sample:load": "tsx scripts/sample-data/load.ts",
    "sample:validate": "tsx scripts/sample-data/validate.ts",
    "sample:lint": "tsx scripts/sample-data/lint.ts"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.316",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@tanstack/react-query": "^5.100.14",
    "@tanstack/react-virtual": "^3.14.25",
    "@tiptap/extension-link": "^3.32.2",
    "@tiptap/extension-mention": "^3.32.2",
    "@tiptap/extension-placeholder": "^3.32.2",
    "@tiptap/pm": "^3.32.2",
    "@tiptap/react": "^3.32.2",
    "@tiptap/starter-kit": "^3.32.2",
    "@tiptap/suggestion": "^3.32.2",
    "cmdk": "^1.1.1",
    "date-fns": "^4.4.0",
    "drizzle-orm": "^0.45.2",
    "isomorphic-dompurify": "^3.18.0",
    "lucide-react": "^1.66.0",
    "marked": "^15.0.12",
    "nanoid": "^6.0.2",
    "next": "^15.5.19",
    "pg": "^8.21.0",
    "pino": "^9.14.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "recharts": "^3.8.1",
    "zod": "^3.25.76",
    "tsx": "^4.19.2"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.5",
    "@playwright/test": "^1.60.0",
    "@salesforce-ux/icons": "10.18.1",
    "@tailwindcss/postcss": "^4.3.0",
    "@types/node": "^22.10.2",
    "@types/pg": "^8.11.10",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "concurrently": "^10.0.6",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9.39.4",
    "eslint-config-next": "^15.5.19",
    "playwright": "^1.60.0",
    "tailwindcss": "^4.3.0",
    "typescript": "^5.9.3",
    "vitest": "^3.2.6"
  },
  "overrides": {
    "@anthropic-ai/claude-agent-sdk": {
      "zod": "$zod"
    },
    "@anthropic-ai/sdk": {
      "zod": "$zod"
    }
  }
}
